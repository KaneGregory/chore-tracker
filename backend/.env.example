PORT=3001
DB_FILE=./data/chore-tracker.db
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
SESSION_TTL_DAYS=30

# Web Push (generate with: npx web-push generate-vapid-keys). Optional — if unset,
# push notifications are silently skipped rather than failing requests.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
